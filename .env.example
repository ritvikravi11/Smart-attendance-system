# Copy to .env and fill in real values. NEVER commit .env.

ENVIRONMENT=development
DEBUG=true

# ---- Database ----
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=attendance_db
SQL_ECHO=false

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_BEFORE_RUNNING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Seed admin (used only by app/db/init_db.py) ----
SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=Admin@12345

# ---- Face recognition (Module 3+) ----
FACE_MODEL_NAME=buffalo_l
FACE_MATCH_THRESHOLD=0.50
FACE_REVIEW_THRESHOLD=0.40


# ---- Cloudinary (Student Profile Photos) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: CLOUDINARY_SECURE=true
# Optional: CLOUDINARY_UPLOAD_PRESET=student_photos
